{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "frcenterprise333@gmail.com",
        "ascAppId": "db94fcff-20b7-4e3d-bed5-4848e5ad0fa0",
        "appleTeamId": "YUFRU9JZ64"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production"
      }
    },
    "testflight": {
      "ios": {
        "appleId": "frcenterprise333@gmail.com",
        "appleTeamId": "YUFRU9JZ64"
      }
    }
  }
}
